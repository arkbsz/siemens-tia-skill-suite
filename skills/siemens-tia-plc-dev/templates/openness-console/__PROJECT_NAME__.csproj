<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{5FDC09F7-8C33-4D36-A8E0-8EF38D01F45B}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>__PROJECT_NAME__</RootNamespace>
    <AssemblyName>__PROJECT_NAME__</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>Default</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
    <TiaPortalRoot Condition="'$(TiaPortalRoot)' == '' and '$(TiaPortalLocation)' != ''">$(TiaPortalLocation)</TiaPortalRoot>
    <TiaPortalRoot Condition="'$(TiaPortalRoot)' == ''">C:\Program Files\Siemens\Automation\Portal V17</TiaPortalRoot>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Siemens.Engineering">
      <HintPath>$(TiaPortalRoot)\PublicAPI\V17\Siemens.Engineering.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>$(TiaPortalRoot)\PublicAPI\V17\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <None Include="README.md" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="CopySiemensAssemblies" AfterTargets="Build">
    <ItemGroup>
      <SiemensRuntimeAssemblies Include="$(TiaPortalRoot)\PublicAPI\V17\Siemens.Engineering*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SiemensRuntimeAssemblies)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(SiemensRuntimeAssemblies)' != ''" />
  </Target>
</Project>
